                    <span>ريال سعودي (عدن) شراء:</span> <strong class="num-ltr">432 YER</strong>
                </div>
            `;
            document.getElementById('localPricesSummary').innerHTML = sumHtml;
        }

        // Render Currencies
        function renderCurrencies() {
            const tbody = document.getElementById('currenciesTableBody');
            const searchInput = document.getElementById('currencySearch');
            const search = searchInput ? searchInput.value.toLowerCase() : '';
            let html = '';

            for (let [code, curr] of Object.entries(PRICES.currencies)) {
                if (curr.name.toLowerCase().includes(search) || code.toLowerCase().includes(search)) {
                    if (curr.group !== currFilter && currFilter !== 'all') continue;
                    const isFav = favorites.includes(code);
                    const changeClass = curr.change >= 0 ? 'badge-green' : 'badge-red';
                    const arrow = curr.change >= 0 ? '▲' : '▼';
                    html += `
                        <tr>
                            <td><button onclick="toggleFav('${code}')" style="background:none; border:none; cursor:pointer; font-size:16px;">${isFav ? '⭐' : '☆'}</button></td>
                            <td><strong class="num-ltr">${code}</strong></td>
                            <td>${curr.name}</td>
                            <td class="num-ltr">${curr.buy}</td>
                            <td class="num-ltr">${curr.sell}</td>
                            <td><span class="${changeClass} num-ltr">${arrow} ${Math.abs(curr.change)}%</span></td>
                            <td><button class="control-btn" onclick="quickConvertFrom('${code}')">${currentLang === 'ar' ? 'تحويل' : 'Convert'}</button></td>
                        </tr>
                    `;
                }
            }
            tbody.innerHTML = html;
        }

        function setCurrFilter(filter, e) {
            currFilter = filter;
            document.querySelectorAll('#currencies .control-btn').forEach(b => b.classList.remove('active'));
            if(e && e.target) e.target.classList.add('active');
            renderCurrencies();
        }

        function toggleFav(code) {
            if (favorites.includes(code)) {
                favorites = favorites.filter(c => c !== code);
            } else {
                favorites.push(code);
            }
            localStorage.setItem('gml_fav', JSON.stringify(favorites));
            renderCurrencies();
        }

        function filterCurrencies() { renderCurrencies(); }

        // Render Gold Table
        function renderGold() {
            const tbody = document.getElementById('goldTableBody');
            const sarRate = PRICES.currencies.SAR.buy;
            const adenRate = 1625;
            const sanaaRate = 530;
            const usdToSar = sarRate;

            const base24Usd = PRICES.goldOunce / 31.1035;
            const rows = [
                { label: 'أونصة الذهب (XAU)', usd: PRICES.goldOunce },
                { label: 'جنيه ذهب (8 جرام عيار 21)', usd: base24Usd * (21/24) * 8 },
                { label: 'سبيكة 100 جرام (عيار 24)', usd: base24Usd * 100 },
                { label: 'جرام عيار 24', usd: base24Usd },
                { label: 'جرام عيار 22', usd: base24Usd * (22/24) },
                { label: 'جرام عيار 21 (الأكثر تداولاً)', usd: base24Usd * (21/24) },
                { label: 'جرام عيار 18', usd: base24Usd * (18/24) },
                { label: 'جرام عيار 14', usd: base24Usd * (14/24) }
            ];

            let html = '';
            rows.forEach(r => {
                const priceUsd = r.usd;
                const priceSar = priceUsd * usdToSar;
                const yerAdenVal = Math.round(priceUsd * adenRate);
                const yerSanaaVal = Math.round(priceUsd * sanaaRate);

                html += `
                    <tr>
                        <td><strong>${r.label}</strong></td>
                        <td class="num-ltr">$${priceUsd.toFixed(2)}</td>
                        <td class="num-ltr">${priceSar.toFixed(2)} SAR</td>
                        <td class="num-ltr" style="color:var(--green);">${yerAdenVal.toLocaleString()} YER</td>
                        <td class="num-ltr">${yerSanaaVal.toLocaleString()} YER</td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
        }

        // Render Markets
        function renderMarkets() {
            const tbody = document.getElementById('marketsTableBody');
            let html = '';
            for (let [key, m] of Object.entries(PRICES.markets)) {
                if (m.type !== marketFilter && marketFilter !== 'all') continue;
                const changeClass = m.change >= 0 ? 'badge-green' : 'badge-red';
                const arrow = m.change >= 0 ? '▲' : '▼';
                html += `
                    <tr>
                        <td><strong>${m.name}</strong></td>
                        <td class="num-ltr">$${m.price.toLocaleString()}</td>
                        <td><span class="${changeClass} num-ltr">${arrow} ${Math.abs(m.change)}%</span></td>
                        <td><button class="control-btn" onclick="calcWithMarket('${key}')">${currentLang === 'ar' ? 'حساب' : 'Calc'}</button></td>
                    </tr>
                `;
            }
            tbody.innerHTML = html;
        }

        function setMarketFilter(filter, e) {
            marketFilter = filter;
            document.querySelectorAll('#markets .control-btn').forEach(b => b.classList.remove('active'));
            if(e && e.target) e.target.classList.add('active');
            renderMarkets();
        }

        function calcWithMarket(key) {
            switchSection('converter');
        }

        // Currency Converter Logic
        function initConverterSelects() {
            const from = document.getElementById('convFrom');
            const to = document.getElementById('convTo');
            let opts = '';
            for (let code of Object.keys(PRICES.currencies)) {
                opts += `<option value="${code}">${code}</option>`;
            }
            if(from && to) {
                from.innerHTML = opts;
                to.innerHTML = opts;
                from.value = 'USD';
                to.value = 'YER_ADEN';
            }
        }

        function convertCurrency() {
            const amountEl = document.getElementById('convAmount');
            const fromEl = document.getElementById('convFrom');
            const toEl = document.getElementById('convTo');
            if(!amountEl || !fromEl || !toEl) return;

            const amt = parseFloat(amountEl.value) || 0;
            const from = fromEl.value;
            const to = toEl.value;

            const rateFrom = PRICES.currencies[from] ? PRICES.currencies[from].buy : 1;
            const rateTo = PRICES.currencies[to] ? PRICES.currencies[to].buy : 1;

            const valInUsd = amt / rateFrom;
            const result = valInUsd * rateTo;

            document.getElementById('convResult').innerText = `${amt} ${from} = ${result.toLocaleString(undefined, {maximumFractionDigits: 2})} ${to}`;
        }

        function swapCurrencies() {
            const from = document.getElementById('convFrom');
            const to = document.getElementById('convTo');
            if(from && to) {
                const temp = from.value;
                from.value = to.value;
                to.value = temp;
                convertCurrency();
            }
        }

        function setConvQuick(val) {
            const amountEl = document.getElementById('convAmount');
            if(amountEl) {
                amountEl.value = val;
                convertCurrency();
            }
        }

        function quickConvertFrom(code) {
            switchSection('converter');
            const from = document.getElementById('convFrom');
            if(from) {
                from.value = code;
                convertCurrency();
            }
        }

        // Gold Calculator Logic
        function calculateGoldPrice() {
            const weightEl = document.getElementById('calcWeight');
            const caratEl = document.getElementById('calcCarat');
            const makingEl = document.getElementById('calcMaking');
            if(!weightEl || !caratEl || !makingEl) return;

            const weight = parseFloat(weightEl.value) || 0;
            const carat = parseInt(caratEl.value) || 21;
            const making = parseFloat(makingEl.value) || 0;

            const base24Usd = PRICES.goldOunce / 31.1035;
            const caratPriceUsd = base24Usd * (carat / 24);
            const rawTotalUsd = weight * caratPriceUsd;
            const makingTotalUsd = weight * making;
            const totalUsd = rawTotalUsd + makingTotalUsd;
            const totalSar = totalUsd * PRICES.currencies.SAR.buy;
            const totalYer = totalUsd * 1625;

            document.getElementById('calcResult').innerHTML = `
                <div style="font-size:13px; color:var(--text-muted); margin-bottom:5px;">القيمة الخام: $${rawTotalUsd.toFixed(2)} | المصنعية: $${makingTotalUsd.toFixed(2)}</div>
                <div style="font-size:18px; font-weight:bold; color:var(--gold);">الإجمالي: $${totalUsd.toFixed(2)}</div>
                <div style="font-size:14px; margin-top:5px;">${totalSar.toFixed(2)} SAR • ${Math.round(totalYer).toLocaleString()} YER</div>
            `;
        }

        function setWeightQuick(w) {
            const weightEl = document.getElementById('calcWeight');
            if(weightEl) {
                weightEl.value = w;
                calculateGoldPrice();
            }
        }

        function shareCalculation() {
            const weightEl = document.getElementById('calcWeight');
            const caratEl = document.getElementById('calcCarat');
            const weight = weightEl ? weightEl.value : 0;
            const carat = caratEl ? caratEl.value : 21;
            const txt = `حسبة الذهب عبر Global Markets Live: الوزن ${weight} جرام عيار ${carat}`;
            if (navigator.share) {
                navigator.share({ title: 'حسبة الذهب', text: txt, url: window.location.href }).catch(() => {});
            } else {
                navigator.clipboard.writeText(txt);
                alert('تم نسخ تفاصيل الحسبة بنجاح!');
            }
        }

        // Charts Logic with Chart.js
        function initChart(period) {
            const canvas = document.getElementById('marketChart');
            if(!canvas) return;
            const ctx = canvas.getContext('2d');
            let labels = ['Day 1', 'Day 2', 'Day 3', 'Day 4', 'Day 5', 'Day 6', 'Today'];
            let dataPoints = [2610, 2625, 2618, 2635, 2640, 2645, PRICES.goldOunce];

            if (period === '1D') {
                labels = ['09:00', '11:00', '13:00', '15:00', '17:00', '19:00', 'Now'];
                dataPoints = [2642, 2644, 2643, 2647, 2646, 2649, PRICES.goldOunce];
            } else if (period === '30D') {
                labels = ['Week 1', 'Week 2', 'Week 3', 'Week 4'];
                dataPoints = [2580, 2610, 2630, PRICES.goldOunce];
            } else if (period === '1Y') {
                labels = ['Q1', 'Q2', 'Q3', 'Q4'];
                dataPoints = [2150, 2350, 2550, PRICES.goldOunce];
            }

            if (chartInstance) chartInstance.destroy();

            chartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'XAU/USD',
                        data: dataPoints,
                        borderColor: '#F0B90B',
                        backgroundColor: 'rgba(240,185,11,0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { color: 'rgba(255,255,255,0.05)' } },
                        y: { grid: { color: 'rgba(255,255,255,0.05)' } }
                    }
                }
            });
        }

        function changeChartPeriod(period, e) {
            const periodBtns = document.getElementById('chartPeriodBtns');
            if(periodBtns) {
                periodBtns.querySelectorAll('.control-btn').forEach(b => b.classList.remove('active'));
            }
            if(e && e.target) e.target.classList.add('active');
            initChart(period);
        }

        // News Render
        function renderNews() {
            const container = document.getElementById('newsContainer');
            if(!container) return;
            container.innerHTML = PRICES.news.map(n => `
                <div class="card" style="margin-bottom:0; padding:15px;">
                    <h4 style="margin-bottom:5px; font-size:14px;"><a href="#" onclick="alert('${n.title}'); return false;" style="color:var(--text-main); text-decoration:none;">${n.title}</a></h4>
                    <div style="font-size:11px; color:var(--text-muted); display:flex; justify-content:space-between;">
                        <span>${n.source}</span>
                        <span>${n.time}</span>
                    </div>
                </div>
            `).join('');
        }

        // FAQ Render
        function renderFaq() {
            const container = document.getElementById('faqContainer');
            if(!container) return;
            container.innerHTML = PRICES.faq.map(f => `
                <div class="faq-item" onclick="toggleFaq(this)">
                    <div class="faq-question">${f.q} <span>▼</span></div>
                    <div class="faq-answer">${f.a}</div>
                </div>
            `).join('');
        }

        function toggleFaq(el) {
            el.classList.toggle('active');
        }

        // Modal Actions
        function openAlertModal() { 
            const m = document.getElementById('alertModal');
            if(m) m.classList.add('active'); 
        }
        function closeAlertModal() { 
            const m = document.getElementById('alertModal');
            if(m) m.classList.remove('active'); 
        }
        function openAdModal(e) { 
            if(e) e.preventDefault(); 
            const m = document.getElementById('adModal');
            if(m) m.classList.add('active'); 
        }
        function closeAdModal() { 
            const m = document.getElementById('adModal');
            if(m) m.classList.remove('active'); 
        }
        function closeStickyAd() { 
            const s = document.getElementById('stickyFooterAd');
            if(s) s.style.display = 'none'; 
        }
        function closeTopBanner() {
            const b = document.getElementById('topAdBanner');
            if(b) b.style.display = 'none';
        }

        function saveAlert() {
            const phoneEl = document.getElementById('alertPhone');
            const phone = phoneEl ? phoneEl.value : '';
            if (!phone || phone.length < 9 || !phone.startsWith('7')) {
                alert('الرجاء إدخال رقم واتساب صحيح يبدأ بـ 7 ويتكون من 9 أرقام.');
                return;
            }
            alert('تم تفعيل التنبيه بنجاح وسيتم إرسال إشعار عبر واتساب عند الوصول للسعر المحدد.');
            closeAlertModal();
        }

        function sharePage() {
            if (navigator.share) {
                navigator.share({ title: document.title, url: window.location.href }).catch(() => {});
            } else {
                navigator.clipboard.writeText(window.location.href);
                alert('تم نسخ رابط الموقع بنجاح!');
            }
        }

        function copyPrices() {
            const text = `أسعار الذهب والعملات اليوم:\n- أونصة الذهب: $${PRICES.goldOunce.toFixed(2)}\n- دولار عدن: 1,625 YER\n- ريال سعودي: 3.75 SAR`;
            navigator.clipboard.writeText(text);
            alert('تم نسخ ملخص الأسعار بنجاح!');
        }
    </script>
</body>
